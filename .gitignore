# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Isolated verification builds are generated, like the default .next output.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local browser verification and temporary build outputs
/.auth-evidence/
/.catalog-evidence/
/.commerce-evidence/
/.detail-evidence/
/.header-evidence/
/premium-audit.json

/.landing-evidence/

!.env.example

# Python environments, caches and private database artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.dump
*.backup

# DBML CLI error output
/dbml-error.log
