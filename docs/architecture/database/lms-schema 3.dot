certificate_templates [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#6478E5"><FONT COLOR="white"><B>certificate_templates</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">locale</TD><TD ALIGN="LEFT">locale</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">template_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT">timestamptz ?</TD></TR><TR><TD ALIGN="LEFT">FK approved_by</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD ALIGN="LEFT">issuer_identity</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
certificates [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#6478E5"><FONT COLOR="white"><B>certificates</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">certificate_number</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">FK request_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">FK enrollment_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">FK template_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">FK issued_to</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">FK issued_by</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">student_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">course_title</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">trainer_name</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT">FK locale</TD><TD ALIGN="LEFT">locale</TD></TR><TR><TD ALIGN="LEFT">pdf_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">issued_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT">issuer_identity</TD><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
}
