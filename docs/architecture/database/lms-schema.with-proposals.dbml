// PROPOSED ONLY: the following four tables are NOT migrated.
Enum promo_type {
  fixed
  percentage
}

Enum commission_accrual_status {
  draft
  pending
  paid
  returned
  failed
}

Enum payout_status {
  pending
  paid
  failed
}

Table promocodes [headercolor: #E39B33, note: 'DEFERRED / NOT MIGRATED; OQ-034/035. PHASE 2. Redemption concurrency/eligibility remains unresolved.'] {
  id uuid [pk]
  code text [not null, unique]
  type promo_type [not null]
  value integer [not null]
  max_uses integer
  starts_at timestamptz
  expires_at timestamptz
  is_active boolean [not null, default: true]
  checks { `value >= 0` [name: 'ck_promocodes_nonnegative_value'] }
}

Table commission_accruals [headercolor: #E39B33, note: 'DEFERRED / NOT MIGRATED; OQ-058–064. PHASE 2 OPTIONAL. Historical earnings, not cash payouts.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  order_item_id uuid [not null, ref: > order_items.id]
  amount_cents bigint [not null]
  currency varchar(3) [not null, default: 'USD']
  status commission_accrual_status [not null]
  payout_id uuid [ref: > payouts.id]
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
}

Table payouts [headercolor: #E39B33, note: 'DEFERRED / NOT MIGRATED; OQ-062/064. PHASE 2. Payouts are distinct financial transfers.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  amount_cents bigint [not null]
  currency varchar(3) [not null, default: 'USD']
  status payout_status [not null]
  created_at timestamptz [not null, default: `now()`]
  paid_at timestamptz
}

Table notification_templates [headercolor: #667588, note: 'DEFERRED / NOT MIGRATED; OQ-069. OPTIONAL: may instead live as versioned backend files.'] {
  id uuid [pk]
  code text [not null]
  name text [not null]
  locale locale [not null]
  channel notification_channel [not null]
  title text [not null]
  body text [not null]
  action_url text
  indexes { (code, locale, channel) [unique] }
}

TableGroup Deferred_Commerce [color: #E39B33] {
  promocodes
  commission_accruals
  payouts
}
TableGroup Deferred_Notifications [color: #667588] {
  notification_templates
}
