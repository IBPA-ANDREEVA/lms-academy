assignments [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD PORT="header" BGCOLOR="#DF6489"><FONT COLOR="white"><B>Assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">assignments</TD></TR><TR><TD ALIGN="LEFT">submission_attachments</TD></TR><TR><TD ALIGN="LEFT">submission_reviews</TD></TR><TR><TD ALIGN="LEFT">submissions</TD></TR></TABLE>>];
certificates [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD PORT="header" BGCOLOR="#6478E5"><FONT COLOR="white"><B>Certificates</B></FONT></TD></TR><TR><TD ALIGN="LEFT">certificate_requests</TD></TR><TR><TD ALIGN="LEFT">certificate_templates</TD></TR><TR><TD ALIGN="LEFT">certificates</TD></TR></TABLE>>];
notifications [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD PORT="header" BGCOLOR="#667588"><FONT COLOR="white"><B>Notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT">notifications</TD></TR></TABLE>>];
assignments:header:e -> catalog:header:w;
assignments:header:e -> identity:header:w;
assignments:header:e -> learning:header:w;
