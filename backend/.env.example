# Documentation only: no code auto-loads this file. Inject secrets privately.
LMS_ENV=development
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:REPLACE_LOCALLY@127.0.0.1:5432/lms_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:REPLACE_LOCALLY@127.0.0.1:5432/lms_dev
# Complete PostgreSQL 18 distribution; use the platform's actual path.
POSTGRES_BIN=/absolute/path/to/postgresql18/bin
# Remote development/staging only: verify the branch in Neon first.
# DATABASE_NONPRODUCTION_HOST=YOUR_NONPRODUCTION_DIRECT_ENDPOINT
# DATABASE_NONPRODUCTION_NAME=YOUR_NONPRODUCTION_DATABASE
# Runtime URLs for remote targets must explicitly require TLS.
# Never set TEST_POSTGRES_ADMIN_URL to a shared/Neon target.
# Use scripts/verify_postgres.py; it generates all test credentials itself.
