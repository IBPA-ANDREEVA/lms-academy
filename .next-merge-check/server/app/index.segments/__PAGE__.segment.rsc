38:["$","section",null,{"id":"founder","className":"-VypMa_section","aria-labelledby":"founder-title","children":[["$","div",null,{"data-motion-photo":true,"className":"-VypMa_photograph","children":["$","$L14",null,{"src":{"src":"/_next/static/media/lдля клиентов 77 3 копія.2dhut4lu0sj7d.jpg","width":3466,"height":4785,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/jpeg;base64,"},"alt":"Юлия Андреева среди инструментов для работы в сфере красоты","fill":true,"sizes":"(max-width: 600px) 100vw, 54vw","className":"-VypMa_image"}]}],["$","div",null,{"className":"-VypMa_plumWedge","aria-hidden":"true"}],["$","div",null,{"className":"-VypMa_edgeLine","aria-hidden":"true"}],["$","$L36",null,{"children":[["$","p",null,{"className":"-VypMa_kicker","children":"ОСНОВАТЕЛЬ"}],["$","h2",null,{"data-motion-item":true,"id":"founder-title","className":"-VypMa_heading","children":[["$","span",null,{"children":"ОПЫТ,"}],["$","span",null,{"children":"КОТОРЫЙ СОЗДАЁТ"}],["$","span",null,{"children":"ВОЗМОЖНОСТИ"}]]}],["$","div",null,{"data-motion-item":true,"className":"-VypMa_biography","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Юлия Андреева"}]," — основательница LMS Academy и президент International Beauty Professionals Association (IBPA)."]}],["$","$L46",null,{"children":[["$","p",null,{"children":"До бьюти-индустрии 12 лет работала в фармацевтическом бизнесе и дошла до руководителя региона «Москва». Оттуда — системный подход к обучению и внимание к стандартам качества."}],["$","p",null,{"children":"В 2019 году начала работать лэшмейкером и стала победительницей чемпионатов по наращиванию ресниц. В 2021 году открыла в Москве школу-студию наращивания ресниц «Lashes Room Юлии Андреевой», и в первый же год её оборот составил 6 млн рублей. В 2022 году открыла школу-студию в Турции, в 2024 году — в Роклине, Калифорния."}],["$","p",null,{"children":"За свою карьеру обучила более 100 учеников по всему миру. В США помогла более чем 500 мастерам получить бьюти-лицензию. Создала профессиональное сообщество IBPA и с 2024 года организует ежегодный Beauty Business Forum для бьюти-мастеров."}]]}]]}],["$","ol",null,{"className":"-VypMa_milestones","aria-label":"Профессиональный путь","children":[["$","li","Бьюти-профессионал",{"data-motion-item":true,"children":[["$","span",null,{"className":"-VypMa_number","aria-hidden":"true","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Бьюти-профессионал"}],["$","p",null,{"children":"Лэшмейкер с 2019 года, победительница чемпионатов."}]]}]]}],["$","li","Преподаватель",{"data-motion-item":true,"children":[["$","span",null,{"className":"-VypMa_number","aria-hidden":"true","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Преподаватель"}],["$","p",null,{"children":"Более 100 учеников по всему миру, школы-студии в Москве, Турции и Калифорнии."}]]}]]}],["$","li","Предприниматель",{"data-motion-item":true,"children":[["$","span",null,{"className":"-VypMa_number","aria-hidden":"true","children":"03"}],["$","div",null,{"children":["$L47","$L48"]}]]}],"$L49"]}]],"treatment":"portrait","className":"PVC98W_container PVC98W_wide -VypMa_content"}]]}]
