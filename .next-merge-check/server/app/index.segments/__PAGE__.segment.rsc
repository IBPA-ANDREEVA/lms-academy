1f:["$","section",null,{"id":"faq","className":"VEg6Wa_section","aria-labelledby":"faq-title","children":["$","$L36",null,{"children":[["$","div",null,{"className":"VEg6Wa_intro","children":[["$","p",null,{"className":"VEg6Wa_kicker","children":"FAQ / ОБ ОБУЧЕНИИ"}],["$","h2",null,{"id":"faq-title","children":["Частые",["$","br",null,{}],["$","span",null,{"children":"вопросы."}]]}],["$","p",null,{"className":"VEg6Wa_description","children":"О формате обучения, поддержке куратора и сертификатах. Ответы на вопросы до выбора курса."}]]}],["$","div",null,{"className":"VEg6Wa_questions","children":[[["$","$L41","formats",{"id":"formats","question":"Чем основной курс отличается от мини-курса?","answer":"Основной курс предполагает практику и поддержку куратора. Мини-курс — самостоятельное обучение в записи, без куратора и проверки домашних заданий.","initiallyOpen":true}],["$","$L41","learning",{"id":"learning","question":"Как проходит обучение?","answer":"Обучение проходит онлайн: вы смотрите записанные уроки и изучаете материалы курса. На основных курсах выполняете практические задания и получаете обратную связь куратора. Состав и порядок занятий зависят от выбранной программы.","initiallyOpen":false}],["$","$L41","access",{"id":"access","question":"Сколько времени доступны уроки и материалы?","answer":"По правилам обучения доступ действует 3 календарных месяца с момента, когда вы явно подтверждаете ознакомление с вводной страницей правил курса. Для каждого приобретённого курса срок отсчитывается отдельно. Изменения сроков и приостановки оформляются уполномоченными сотрудниками академии.","initiallyOpen":false}],["$","$L41","support",{"id":"support","question":"Как работает поддержка куратора?","answer":"На основном курсе поддержка длится 14 календарных дней подряд с подтверждения ознакомления с вводными правилами. Она заканчивается раньше доступа к урокам. Работы, отправленные в разрешённый срок, должны быть проверены, даже если проверка завершится после окончания поддержки. У мини-курсов кураторской поддержки нет.","initiallyOpen":false}],["$","$L41","languages",{"id":"languages","question":"На каком языке можно учиться?","answer":"Языки зависят от выбранного курса: русский, английский или оба. Доступные языки, аудиодорожки и субтитры нужно проверять в описании конкретной программы.","initiallyOpen":false}],["$","$L41","certificates",{"id":"certificates","question":"Как получить сертификат?","answer":"Для основного курса требуется принятие всех обязательных домашних заданий, для мини-курса — завершение всех обязательных уроков. Затем администратор проверяет подтверждения выполнения и вручную выдаёт сертификат. Завершение уроков не означает автоматическую выдачу.","initiallyOpen":false}],["$","$L41","license",{"id":"license","question":"Заменяет ли сертификат профессиональную лицензию?","answer":"Нет. Сертификат подтверждает прохождение обучения и не является профессиональной лицензией. Требования к праву на работу зависят от профессии и места, где вы планируете практиковать.","initiallyOpen":false}]],["$","div",null,{"className":"VEg6Wa_contact","children":[["$","strong",null,{"children":"Не нашли ответ?"}],["$","a",null,{"href":"#contact","children":"Напишите нам ↗"}]]}]]}]],"treatment":"compact","className":"PVC98W_container PVC98W_wide VEg6Wa_layout"}]}]
